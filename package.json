{
  "name": "codeatlas-mcp-server",
  "version": "0.3.1",
  "description": "High-performance native Rust MCP server for CodeAtlas — AST analysis, codebase intelligence, semantic memory, and A2A orchestration.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "bin": {
    "codeatlas-enterprise": "bin/codeatlas.js",
    "codeatlas-mcp": "bin/codeatlas.js",
    "codeatlas": "bin/codeatlas.js",
    "codeatlas-setup-claude": "bin/codeatlas-setup-claude.js"
  },
  "files": [
    "bin",
    "index.js",
    "Cargo.toml",
    "Cargo.lock",
    "crates",
    "src",
    "README.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giauphan/codeatlas-mcp-server.git"
  },
  "homepage": "https://github.com/giauphan/codeatlas-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/giauphan/codeatlas-mcp-server/issues"
  },
  "scripts": {
    "build": "cargo build --release && node bin/copy-binary.js",
    "start": "cargo run --release",
    "lint": "cargo clippy --all-targets -- -D warnings && cargo fmt --all -- --check",
    "test": "cargo test --workspace",
    "postinstall": "node bin/install.js",
    "prepublishOnly": "cargo build --release && node bin/copy-binary.js"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "codeatlas",
    "rust",
    "code-analysis",
    "ast",
    "ai",
    "codebase-intelligence",
    "enterprise"
  ],
  "author": "Giau Phan <giauphan012@gmail.com>",
  "license": "MIT"
}
